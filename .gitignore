# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
venv/
env/
pacsp_env/

# 系统
.DS_Store
Thumbs.db

# 临时产物（可重新生成）
cache/tamper_test/

# 密钥（绝不提交）
*.pem
*.key

# 投稿构建中间产物（公式图与 DOCX 可由脚本重建）
build/

# 编译产物（任何层级）
**/__pycache__/
**/*.py[cod]

# 以 centroid 标定重算的臂（可由 pacsp_build.py 重建）
records_centroid/

# records_centroid/ 是构建产物，默认忽略（见上）。
# 例外：下列效度证据文件被 -f 强制入库，因为它们是 docs/MEASUREMENT-VALIDITY.md
# 所引用的原始数字来源，重跑需数分钟且顺序敏感。\n# !records_centroid/order_sensitivity.json 等由 -f 显式加入。
